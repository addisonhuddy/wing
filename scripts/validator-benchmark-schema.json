{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "email", "tags", "amount", "items", "note"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string",
      "pattern": "^n[0-9]+$"
    },
    "email": {
      "type": "string",
      "pattern": "^[^@]+@[^@]+\\.[^@]+$"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "multipleOf": 0.01
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 8
    },
    "items": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["sku", "qty"],
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "qty": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        },
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string",
      "minLength": 500,
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
